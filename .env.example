# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# ESTIMATION CAMPUS INC. — ZOHO MAIL SMTP CONFIGURATION
# Deliver all website inquiries & quote requests directly to: info@estimationcampusinc.com
# Configure these 7 environment variables in Hostinger hPanel -> Node.js -> Environment Variables
# ==============================================================================

# 1. Zoho Mail SMTP Server (Use smtppro.zoho.com for Zoho Workplace domain email)
SMTP_HOST="smtppro.zoho.com"

# 2. Port: 465 (SSL) or 587 (TLS)
SMTP_PORT="465"

# 3. Secure: true for port 465, false for port 587
SMTP_SECURE="true"

# 4. Your Zoho Mail account username (full email address)
SMTP_USER="info@estimationcampusinc.com"

# 5. Zoho Application-Specific Password (generate from Zoho Accounts -> Security -> App Passwords)
SMTP_PASSWORD="YOUR_ZOHO_APP_PASSWORD"

# 6. Primary Destination Address
EMAIL_TO="info@estimationcampusinc.com"

# 7. Sender address (Must be your Zoho email address or an authorized alias in Zoho)
EMAIL_FROM="Estimation Campus Inc. <info@estimationcampusinc.com>"
